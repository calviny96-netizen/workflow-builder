{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": { "@nodes": ["../../packages/nodes/src/index.ts"] }
  },
  "include": ["src", "../../packages/nodes/src"],
  "exclude": ["../../packages/**/*.test.ts"]
}
