# Salin file ini menjadi .env lalu isi. File .env tidak ikut ke git.

AUTOAUDIT_BASE_URL=https://app-autoaudit.ordoagentic.ai
# Integration API Key dari API Management AutoAudit
AUTOAUDIT_API_KEY=

# Company dan sales yang aman dipakai untuk uji kontrak (Fase 0)
AA_TEST_COMPANY_ID=
AA_TEST_SALES_ID=
# false = jalankan di Company, true = jalankan di Superadmin
AA_TEST_RUN_BY_SUPERADMIN=false

# Opsional. Kosong = kemarin (WIB). Pilih tanggal yang chat-nya sedikit supaya run mini murah.
AA_TEST_DATE=
# Opsional. Kosong = model anchor dari /audital-work/models
AA_TEST_MODEL=
AA_TEST_TIMEZONE=Asia/Jakarta

# Database. Untuk lokal jalankan `npm run db` (Postgres tertanam, data di .data/postgres).
# Di server ganti dengan Postgres sungguhan.
DATABASE_URL=postgres://aawb:aawb-local@127.0.0.1:54329/aawb

# Login aplikasi. Setiap server hidup, user ini dibuat atau password-nya disamakan dengan nilai di sini.
# Mengganti password: ubah di sini lalu jalankan ulang server.
ADMIN_EMAIL=admin@ordo.local
ADMIN_PASSWORD=

# Opsional
# PORT=8787
# AW_CONCURRENCY=5        batas global Audital Work bersamaan

# Kirim Pesan lewat GOWA (WhatsApp). Sama dengan credential Basic Auth di n8n.
# GOWA_BASE_URL=https://gowa.testserver-ordoapps.com
# GOWA_USER=
# GOWA_PASSWORD=
# GOWA_DEVICE_ID=          nilai header X-Device-Id pada node HTTP Request di n8n
